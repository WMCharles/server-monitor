# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs. Leave empty only long enough
# to use /whoami and discover your ID.
ALLOWED_USER_IDS=
# Chat/group ID that receives automatic alerts.
ALERT_CHAT_ID=

# General
SERVER_NAME=production-01
# Multi-VM: path to a JSON host inventory (see hosts.example.json).
# Leave empty (or unset) to run in single-VM mode.
# HOSTS_FILE=/opt/server-monitor/hosts.json
TIMEZONE=Africa/Nairobi
CHECK_INTERVAL_SECONDS=60
SLOW_CHECK_INTERVAL_SECONDS=3600
COMMAND_TIMEOUT_SECONDS=8
HTTP_TIMEOUT_SECONDS=5
ALERT_BREACH_COUNT=3
ALERT_RECOVERY_COUNT=2
STATE_DB=./data/server_monitor.sqlite3

# Thresholds
CPU_WARNING=85
CPU_CRITICAL=95
MEMORY_WARNING=85
MEMORY_CRITICAL=95
SWAP_WARNING=20
SWAP_CRITICAL=50
DISK_WARNING=80
DISK_CRITICAL=90
INODE_WARNING=80
INODE_CRITICAL=90
IOWAIT_WARNING=15
IOWAIT_CRITICAL=25
LOAD_WARNING_MULTIPLIER=1.0
LOAD_CRITICAL_MULTIPLIER=1.5

# Filesystems to inspect.
DISK_MOUNTS=/

# systemd services to monitor.
MONITORED_SERVICES=nginx,docker,postgresql
# Services users may request via /logs. Usually the same or a subset.
LOG_SERVICES=nginx,docker,postgresql

# Containers users may request via /logs (read via `docker logs`).
LOG_CONTAINERS=

# Application log files users may request via /logs and that are scanned for
# new error lines. Format: name|/absolute/path,name|/absolute/path
# Example:
# LOG_FILES=api|/var/www/app/storage/logs/laravel.log,worker|/var/www/app/storage/logs/worker.log
LOG_FILES=

# Substrings marking a log line as an error (case-sensitive).
LOG_ERROR_PATTERNS=.ERROR,.CRITICAL,.ALERT,.EMERGENCY
# New matching lines in a single check needed before alerting.
LOG_ERROR_THRESHOLD=5
# How often LOG_FILES are scanned for new errors (min 60).
LOG_CHECK_INTERVAL_SECONDS=300

# Docker container names that MUST be running.
# Leave empty to show all containers but not alert on specific names.
MONITORED_CONTAINERS=

# Health checks: name|URL,name|URL
# Example:
# HEALTH_URLS=main-api|https://api.example.com/health,admin|https://admin.example.com/
HEALTH_URLS=

# Expected TCP ports: name|host|port,name|host|port
# Example:
# MONITORED_PORTS=ssh|127.0.0.1|22,http|127.0.0.1|80,https|127.0.0.1|443
MONITORED_PORTS=ssh|127.0.0.1|22

# Database. Supported values: postgres, mysql, tcp, none
DB_TYPE=none
DB_HOST=127.0.0.1
DB_PORT=
DB_NAME=

# TLS certificates: name|hostname|port
# Example:
# SSL_TARGETS=api|api.example.com|443,admin|admin.example.com|443
SSL_TARGETS=

# Backup checks: name|path|max_age_hours
# Path can be a file or directory. For a directory, newest file mtime is used.
# Example:
# BACKUP_TARGETS=postgres|/var/backups/postgresql|26,app|/var/backups/app|26
BACKUP_TARGETS=

# Journal/security
ERROR_LOOKBACK_MINUTES=30
SSH_LOOKBACK_MINUTES=60
